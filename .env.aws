REACT_APP_ENV=PRODUCTION
NODE_OPTIONS=--max-old-space-size=8192 --no-deprecation
GENERATE_SOURCEMAP=false
# AWS test server (EC2 "ereshme-back end", 65.0.131.10). nginx serves the UI at /seriui/ and proxies each
# backend path to its port on the same box, so every URL here is same-origin.
REACT_APP_API_BASE_URL_REGISTRATION=http://65.0.131.10/farmer-registration/v1/
REACT_APP_API_BASE_URL_REGISTRATION_FRUITS=http://65.0.131.10/farmer-registration/v1/
